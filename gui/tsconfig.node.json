{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "hostBridge.ts", "vitest.config.ts", "playwright.config.ts"]
}
