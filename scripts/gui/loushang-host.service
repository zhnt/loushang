[Unit]
Description=Loushang Coding AppHost

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=%h
RuntimeDirectory=loushang-host
RuntimeDirectoryMode=0700
Environment=LOUSHANG_RUNTIME_DIR=%t/loushang-host
ExecStart=/usr/bin/loushang-mux service run
KillMode=mixed
TimeoutStartSec=75s
TimeoutStopSec=40s
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
