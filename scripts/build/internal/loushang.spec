Name: loushang
Version: %{product_version}
Release: 1%{?dist}
Summary: Loushang desktop, terminal, Web and AppHost
License: Apache-2.0
Requires: libayatana-appindicator-gtk3, ca-certificates, xdg-utils
# Native requirements are generated by RPM. The prebuilt payload also contains
# private Python libraries that are resolved from its own runtime directory.
%global debug_package %{nil}
%global __os_install_post %{nil}

%description
Loushang desktop, terminal and Web clients with a bundled AppHost runtime.

%install
mkdir -p "%{buildroot}"
cp -a "%{payload}/." "%{buildroot}/"

%pre -f %{guard}
%preun -f %{guard}

%files
%defattr(-,root,root,-)
/opt/loushang
/usr/bin/loushang
/usr/bin/loushang-tui
/usr/bin/loushang-mux
/usr/lib/systemd/user/loushang-host.service
/usr/share/applications/ai.loushang.desktop
/usr/share/icons/hicolor/128x128/apps/ai.loushang.harnessgui.png
